<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>RagnaroksWrath.Client</AssemblyName>
    <RootNamespace>RavenIron.RagnaroksWrath.Client</RootNamespace>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Company>Raven Iron</Company>
    <Product>Ragnarok's Wrath - Client</Product>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup>
    <LibsDir>$(MSBuildThisFileDirectory)..\libs</LibsDir>
  </PropertyGroup>

  <Target Name="CheckLibs" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(LibsDir)\assembly_valheim_publicized.dll')"
           Text="libs\ is missing or empty. Run tools\fetch-libs.ps1 to populate it from your Valheim install." />
  </Target>

  <ItemGroup>
    <Reference Include="assembly_valheim">
      <HintPath>$(LibsDir)\assembly_valheim_publicized.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(LibsDir)\assembly_utils_publicized.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- The client renders, so it needs more Unity modules than the server -->
    <Reference Include="UnityEngine">
      <HintPath>$(LibsDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(LibsDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(LibsDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(LibsDir)\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(LibsDir)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(LibsDir)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Valheim rendering assemblies - for storm/fog/fire visual work -->
    <Reference Include="assembly_postprocessing">
      <HintPath>$(LibsDir)\assembly_postprocessing_publicized.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_lux">
      <HintPath>$(LibsDir)\assembly_lux_publicized.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_sunshafts">
      <HintPath>$(LibsDir)\assembly_sunshafts_publicized.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_guiutils">
      <HintPath>$(LibsDir)\assembly_guiutils_publicized.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="BepInEx">
      <HintPath>$(LibsDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(LibsDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**" />
  </ItemGroup>

</Project>
